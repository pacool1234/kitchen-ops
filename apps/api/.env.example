APP_VERSION=dev
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://kitchen_ops:kitchen_ops@127.0.0.1:5432/kitchen_ops

# Required. Signs session cookies and encrypts 2FA secrets; at least 32 characters.
# Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-me-with-the-output-of-the-command-above
# Required. The API's public base URL.
BETTER_AUTH_URL=http://localhost:5173

# Local-only logins created by db:seed. Obviously fake; never use them anywhere real.
#   counter@example.test / local-only-counter
#   office@example.test  / local-only-office
#   owner@example.test   / local-only-owner   (must set up 2FA on first sign-in)

 # Sentry error tracking: the API project's DSN. Leave empty locally, which keeps Sentry off.
SENTRY_DSN=
# "staging" or "production" on Render. Empty: NODE_ENV.
SENTRY_ENVIRONMENT=

# Staging's demo only (decision 0028): `db:seed` with SEED_DEMO=true seeds the demo restaurant and
# one login per role, whose passwords (12 characters or more) come from these. Never set them in
# production; locally the seed uses the local-only logins instead.
SEED_DEMO=true
DEMO_PASSWORD_COUNTER=
DEMO_PASSWORD_OFFICE=
DEMO_PASSWORD_OWNER=