{
  "name": "@kitchen-ops/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --import tsx --import ./src/instrument.ts src/server.ts",
    "sentry:test": "tsx --env-file-if-exists=.env src/sentry-test.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "fast-check": "^4.10.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@kitchen-ops/shared": "workspace:*",
    "@sentry/node": "^11.8.0",
    "better-auth": "catalog:",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "catalog:"
  }
}
