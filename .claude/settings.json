{
  "permissions": {
    "deny": [
      "Read(./eval/private/**)",
      "Edit(./eval/private/**)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-private.mjs"],
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
